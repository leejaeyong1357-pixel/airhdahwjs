# TECZEN 사내 마크 서버 설정 (Luanti)
# setup.cmd 가 이 파일을 server.conf 로 복사해서 쓴다. 바꿀 때는 server.conf 를 고치고 서버를 다시 켠다.

# ── 서버 이름 · 안내 ────────────────────────────────
server_name = TECZEN 사내 서버
server_description = 테크젠 사내 전용 서버
motd = 테크젠 사내 서버에 오신 걸 환영합니다! 닉네임은 영문으로 만들어 주세요.

# 공개 서버 목록에 올리지 않는다 (사내 전용 — true 로 바꾸지 말 것)
server_announce = false

# ── 접속 ─────────────────────────────────────────────
port = 30000
max_users = 30
# 비밀번호 없는 계정 금지 (처음 접속할 때 정한 비밀번호가 그 닉네임의 비밀번호가 된다)
disallow_empty_password = true
# 새로 들어온 사람의 기본 권한 (블록 쓰기 · 채팅)
default_privs = interact, shout
# 버전이 조금 달라도 접속 허용
strict_protocol_version_checking = false
ask_reconnect_on_crash = true

# ── 게임 규칙 ────────────────────────────────────────
# 서바이벌 (배고픔 · 데미지 있음). 크리에이티브로 하려면 creative_mode = true
enable_damage = true
creative_mode = false
# 사내 서버라 플레이어끼리 공격은 끔
enable_pvp = false
